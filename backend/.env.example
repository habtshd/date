# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dating_app?schema=app"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-12345"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Payment Providers (Telebirr, Chapa)
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="chapa-webhook-secret-key"
TELEBIRR_APP_ID="telebirr-app-id"
TELEBIRR_APP_KEY="telebirr-app-key"
TELEBIRR_SHORT_CODE="12345"

# Pricing (ETB per unique conversation unlock)
CONVERSATION_UNLOCK_PRICE_ETB=50.00

# SMS / OTP Provider (Twilio, Ethio Telecom SMS, etc.)
OTP_SMS_MOCK_ENABLED=true
OTP_DEFAULT_CODE="123456"
